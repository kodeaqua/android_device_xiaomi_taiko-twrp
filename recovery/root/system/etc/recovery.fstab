# 1 "vendor/mediatek/proprietary/hardware/fstab/mt6789/fstab.in.mt6789"
# 1 "<built-in>" 1
# 1 "<built-in>" 3
# 400 "<built-in>" 3
# 1 "<command line>" 1
# 1 "<built-in>" 2
# 1 "vendor/mediatek/proprietary/hardware/fstab/mt6789/fstab.in.mt6789" 2
# 154 "vendor/mediatek/proprietary/hardware/fstab/mt6789/fstab.in.mt6789"
# The `avb_keys=/avb/{q,r,s}-gsi.avbpubkey` suffix these four lines carried,
# inherited from the MTK fstab template, is dropped. It was inert in two
# independent ways. TWRP parses this file with its own
# TWPartition::Process_Fstab_Line, which does not know the token at all and
# silently ignores it (partition.cpp never mentions avb). And even under
# fs_mgr, which does parse it (fs_mgr_fstab.cpp:285), the mount path checks
# `fs_mgr_flags.avb` first and only falls through to the standalone
# avb_keys branch when it is unset (fs_mgr.cpp:1450/1466) - these lines set
# it via `avb=vbmeta_system`, so the keys were never consulted. On top of
# that no /avb directory exists in either ramdisk fragment, and GSI keys
# from the Q/R/S era would not cover a current GSI anyway.
system /system erofs ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system /system ext4 ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system_ext /system_ext erofs ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system_ext /system_ext ext4 ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount

vendor /vendor erofs ro wait,slotselect,avb,logical,first_stage_mount
vendor /vendor ext4 ro wait,slotselect,avb,logical,first_stage_mount


product /product erofs ro wait,slotselect,avb,logical,first_stage_mount
product /product ext4 ro wait,slotselect,avb,logical,first_stage_mount
# The ~25 "overlay ... lowerdir=..." entries that followed here (verbatim
# from stock, MIUI's product/system customization layering) were removed:
# TWRP's fstab parser doesn't implement bind mounts or the "overlay"
# fstype at all, so every one of them logged "E:Unknown File System" on
# every boot for zero functional benefit - these overlays only matter for
# full Android runtime (layering MIUI's mi_ext content onto /product and
# /system), not for anything TWRP actually does.
#
# mi_ext ITSELF (the base partition, not the overlay lines above) is a
# real dynamic partition on this device (stock mounts it at
# /mnt/vendor/mi_ext then bind-mounts to /mi_ext - the bind step is
# dropped here for the same reason as the overlays, TWRP doesn't need it,
# just a normal mount) - it got swept out along with the broken overlay
# entries in the same earlier cleanup, which left it completely untracked
# by TWRP's partition manager. Confirmed live: this is what made
# "Wipe > Format Data" fail with "E:Unable to unmap dynamic partitions" -
# mi_ext_a's dm-linear device gets created at boot (it's still real,
# on-device, part of the super partition - see BOARD_MAIN_DYNAMIC_PARTITIONS_
# PARTITION_LIST's comment in BoardConfig.mk) but with no fstab entry
# TWRP never adds it to the partition list it unmaps before/after
# wipe/format operations, so the leftover dm node blocks the whole
# sequence. Re-added as a plain partition entry (no bind/overlay).
mi_ext /mi_ext erofs ro wait,slotselect,avb,logical,first_stage_mount
mi_ext /mi_ext ext4 ro wait,slotselect,avb,logical,first_stage_mount






vendor_dlkm /vendor_dlkm erofs ro wait,slotselect,avb,logical,first_stage_mount
vendor_dlkm /vendor_dlkm ext4 ro wait,slotselect,avb,logical,first_stage_mount


odm_dlkm /odm_dlkm erofs ro wait,slotselect,avb,logical,first_stage_mount
odm_dlkm /odm_dlkm ext4 ro wait,slotselect,avb,logical,first_stage_mount


system_dlkm /system_dlkm erofs ro wait,slotselect,avb,logical,first_stage_mount
system_dlkm /system_dlkm ext4 ro wait,slotselect,avb,logical,first_stage_mount


/dev/block/by-name/metadata /metadata ext4 noatime,nosuid,nodev,discard wait,check,formattable,first_stage_mount

/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,gc_merge,atgc,age_extent_cache,inlinecrypt wait,check,formattable,quota,latemount,resize,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity



/dev/block/by-name/rescue /cache ext4 noatime,nosuid,nodev,noauto_da_alloc,discard wait,check,formattable

/dev/block/by-name/protect1 /mnt/vendor/protect_f ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/protect2 /mnt/vendor/protect_s ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/nvdata /mnt/vendor/nvdata ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/nvcfg /mnt/vendor/nvcfg ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable


/dev/block/by-name/persist /mnt/vendor/persist ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable





# The three `voldmanaged=` lines that used to sit here (two sdcard1 entries
# for the mmc/msdc controllers plus one usbotg entry) were dropped. They are
# vold syntax: real Android hands those device paths to vold, which mounts
# whatever removable media shows up. TWRP does not run vold, so all it could
# do with them was create one generic placeholder partition per line - which
# is exactly the three empty "Storage (0MB)" rows that showed up in
# Install > Select Storage, on top of the "Micro SDCard" and "USB OTG" rows
# TWRP already provides by itself (see Translate_Partition() in
# bootable/recovery/partitionmanager.cpp, which knows /external_sd and
# /usb-otg natively). Removing them only removes the duplicates.

/dev/block/by-name/frp /persistent emmc defaults defaults

/dev/block/by-name/nvram /nvram emmc defaults defaults
/dev/block/by-name/proinfo /proinfo emmc defaults defaults

/dev/block/by-name/lk /bootloader emmc defaults defaults
/dev/block/by-name/lk2 /bootloader2 emmc defaults defaults




/dev/block/by-name/bootloader2 /bootloader2 emmc defaults defaults
/dev/block/by-name/misc /misc emmc defaults defaults
/dev/block/by-name/para /para emmc defaults defaults
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults defaults
/dev/block/by-name/init_boot /init_boot emmc defaults defaults




/dev/block/by-name/boot /boot emmc defaults first_stage_mount,nofail,slotselect





/dev/block/by-name/vbmeta_vendor /vbmeta_vendor emmc defaults first_stage_mount,nofail,slotselect
/dev/block/by-name/vbmeta_system /vbmeta_system emmc defaults first_stage_mount,nofail,slotselect,avb=vbmeta

/dev/block/by-name/logo /logo emmc defaults defaults
/dev/block/by-name/expdb /expdb emmc defaults defaults
/dev/block/by-name/seccfg /seccfg emmc defaults defaults

/dev/block/by-name/tee1 /tee1 emmc defaults defaults
/dev/block/by-name/tee2 /tee2 emmc defaults defaults


/dev/block/by-name/scp1 /scp1 emmc defaults defaults
/dev/block/by-name/scp2 /scp2 emmc defaults defaults


/dev/block/by-name/sspm1 /sspm1 emmc defaults defaults
/dev/block/by-name/sspm2 /sspm2 emmc defaults defaults


/dev/block/by-name/dpm1 /dpm1 emmc defaults defaults
/dev/block/by-name/dpm2 /dpm2 emmc defaults defaults

/dev/block/by-name/mcupm1 /mcupm1 emmc defaults defaults
/dev/block/by-name/mcupm2 /mcupm2 emmc defaults defaults

/dev/block/by-name/efuse /efuse emmc defaults defaults

/dev/block/by-name/md1img /md1img emmc defaults defaults
/dev/block/by-name/md1dsp /md1dsp emmc defaults defaults
/dev/block/by-name/md1arm7 /md1arm7 emmc defaults defaults
/dev/block/by-name/md3img /md3img emmc defaults defaults





/dev/block/by-name/gz1 /gz1 emmc defaults defaults
/dev/block/by-name/gz2 /gz2 emmc defaults defaults
/dev/block/by-name/ccu /ccu emmc defaults defaults
/dev/block/by-name/vcp /vcp emmc defaults defaults
/dev/block/by-name/gpueb /gpueb emmc defaults defaults
/dev/block/by-name/mcf_ota /mcf_ota emmc defaults defaults
# The second, byte-identical `/dev/block/by-name/vendor_boot /vendor_boot`
# entry that sat here was removed. It is already declared above; TWRP's
# Process_Fstab pushes one TWPartition per line without checking for a
# duplicate mount point, so it produced two identical rows in the GUI.
# (The two /bootloader2 lines further up are NOT duplicates in the same
# sense - they name different block devices, lk2 and bootloader2, of
# which only one exists on any given board. Left alone: a partition that
# is not present is simply skipped, and there is no way to tell from here
# which one taiko has.)
/dev/block/by-name/mvpu_algo1 /mvpu_algo1 emmc defaults defaults
/dev/block/by-name/mvpu_algo2 /mvpu_algo2 emmc defaults defaults
/dev/block/by-name/apusys1 /apusys1 emmc defaults defaults
/dev/block/by-name/apusys2 /apusys2 emmc defaults defaults

/dev/block/by-name/spmfw /spmfw emmc defaults defaults







/dev/block/by-name/pi_img /pi_img emmc defaults defaults
/dev/block/by-name/boot_para /boot_para emmc defaults defaults
/dev/block/by-name/odmdtbo /odmdtbo emmc defaults defaults
/dev/block/by-name/dtbo /dtbo emmc defaults defaults

/dev/block/by-name/otp /otp emmc defaults defaults


/dev/block/by-name/vbmeta /vbmeta emmc defaults defaults
