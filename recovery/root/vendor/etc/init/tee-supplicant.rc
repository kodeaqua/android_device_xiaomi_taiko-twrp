# For MTK DRM integration:
service tee-supplicant /vendor/bin/tee-supplicant
    class core
    user system
    group system secure_element nfc
    capabilities SYS_RAWIO
    disabled
    seclabel u:r:recovery:s0

# vendor.keymint-mitee and vendor.gatekeeper_mitee were originally each in
# their own standalone .rc file (android.hardware.security.keymint.mitee@4.0-
# service.rc / android.hardware.gatekeeper-service.mitee.rc, matching stock
# firmware layout) but init never registered either service from those files
# - getprop init.svc.vendor.keymint-mitee came back completely empty (not
# even "stopped"). Root cause finally confirmed: none of the 3 services in
# this file (including tee-supplicant itself, which turned out to have the
# exact same empty-getprop symptom once actually re-tested) had an explicit
# `seclabel` line, and there's no file_contexts entry for any of these
# binaries either - unlike every other service in init.recovery.mt6789.rc
# (touchfeature-hal-1-0, gatekeeper-1-0, mtk.plpath.utils.link), which all
# explicitly set `seclabel u:r:recovery:s0` and all register fine. Without a
# resolvable context, init silently drops the service instead of registering
# it. Fixed by adding the same explicit seclabel here. (The earlier
# standalone-vs-merged-file theory and the drmrpc group removal were both
# real bugs in their own right, just not the actual cause of this specific
# symptom - keeping the merge since it's already proven to parse.)
service vendor.keymint-mitee /vendor/bin/hw/android.hardware.security.keymint@4.0-service.mitee
    class early_hal
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper_mitee /vendor/bin/hw/android.hardware.gatekeeper-service.mitee
    class hal
    user system
    group system
    seclabel u:r:recovery:s0


on fs
    write /proc/bootprof "init tee-supplicant"
    # /mnt/vendor/persist is declared in recovery.fstab but that only
    # registers it with TWRP's own GUI mount manager - it's not mounted
    # automatically at boot the way real firmware's vold/fstab.<hw> would.
    # mitee's TA relies on real storage under here (confirmed live: without
    # this mount, /mnt/vendor/persist/{data,fdsd} below just end up as
    # empty stub dirs in the ramdisk's own rootfs, and the keymint-mitee
    # service SIGABRTs with "MiteeKeymint_ipc: Check failed: status ==
    # STATUS_OK" / TEEC oresult=TEEC_ORIGIN_TRUSTED_APP on its first TEE
    # call that touches persistent storage). Mount it explicitly so the
    # restorecon/mkdir below - and the TA - see the real partition.
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist wait noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc
   # set SELinux security contexts on upgrade or policy update
    restorecon_recursive /mnt/vendor/persist
    chmod 0660 /dev/tee0
    chmod 0660 /dev/teepriv0
    chown system system /dev/tee0
    chown system system /dev/teepriv0
    chmod 0660 /dev/rpmb0
    chmod 0660 /dev/mmcblk0rpmb
    chmod 0660 /dev/0:0:0:49476
    chmod 0660 /dev/ufs-bsg0
    chmod 0666 /dev/kmsg
    chown system system /dev/rpmb0
    chown system system /dev/mmcblk0rpmb
    chown system system /dev/0:0:0:49476
    chown system system /dev/ufs-bsg0
#    enable vendor.keymaster-4-0-mitee
    enable vendor.keymint-mitee
    start tee-supplicant
    mkdir /mnt/vendor/persist/data 0755 system system
    mkdir /mnt/vendor/persist/fdsd 0755 system system
    setprop vendor.teefs_state ready
    setprop ro.hardware.gatekeeper mitee
    # Stock firmware relies on the generic AOSP init.rc's
    # `on late-init { class_start early_hal }` / `class_start hal` to
    # actually launch anything merely `enable`d (which only clears the
    # `disabled` flag - it does NOT start the service by itself) or
    # declared without `disabled` under class `early_hal`/`hal`. TWRP's
    # recovery init.rc doesn't replicate that generic class_start
    # sequence (everything else in this tree is started via explicit
    # `start <name>` tied to specific triggers instead - see
    # gatekeeper-1-0 in init.recovery.mt6789.rc for the existing
    # precedent), so without an explicit start here neither service ever
    # actually launches even though `enable`/registration succeeds -
    # confirmed live: keystore2 got as far as parsing VINTF and
    # negotiating the shared secret, then panicked with "Binder
    # transaction error NAME_NOT_FOUND" trying to connect to KeyMint.
    start vendor.keymint-mitee
    start vendor.gatekeeper_mitee
