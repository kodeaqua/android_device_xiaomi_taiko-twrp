# For MTK DRM integration:
#
# user changed from `system` to `root`: with the stock-platform-fragment
# vendor_boot (see README's KNOWN ISSUE section), manually mounting
# /mnt/vendor/persist live over adb and populating it exactly like this
# file's mount_persist_delayed service does made zero difference to
# keymint-mitee's crash-loop (confirmed live - crashes continued at the
# same ~5s cadence for 5+ minutes after persist was already mounted,
# restorecon'd and set up by hand), which rules out the mount-timing
# race this was all built around. Persist's real, factory-provisioned
# content includes an `otrp` dir that's `drwx------ root system` -
# owner-only, the `system` group grants nothing since the group bits
# are all zero - and every mitee service here (tee-supplicant,
# keymint-mitee, gatekeeper-mitee) runs `user system`, which cannot
# open, read, or write inside it under plain POSIX permissions
# regardless of SELinux (permissive here anyway). That access denial on
# whatever persistent-storage path the TA actually touches is a much
# more direct explanation for "Check failed: status == STATUS_OK" than
# a race that manual testing just disproved. Untested whether `otrp`
# specifically is the path in question (no TA-side tracing available),
# but running as root removes this whole class of problem regardless
# of which persist subpath it turns out to be.
service tee-supplicant /vendor/bin/tee-supplicant
    class core
    user root
    group system secure_element nfc
    capabilities SYS_RAWIO
    disabled
    seclabel u:r:recovery:s0

# vendor.keymint-mitee and vendor.gatekeeper_mitee were originally each in
# their own standalone .rc file (android.hardware.security.keymint.mitee@4.0-
# service.rc / android.hardware.gatekeeper-service.mitee.rc, matching stock
# firmware layout) but init never registered either service from those files
# - getprop init.svc.vendor.keymint-mitee came back completely empty (not
# even "stopped"). Root cause finally confirmed: none of the 3 services in
# this file (including tee-supplicant itself, which turned out to have the
# exact same empty-getprop symptom once actually re-tested) had an explicit
# `seclabel` line, and there's no file_contexts entry for any of these
# binaries either - unlike every other service in init.recovery.mt6789.rc
# (touchfeature-hal-1-0, gatekeeper-1-0, mtk.plpath.utils.link), which all
# explicitly set `seclabel u:r:recovery:s0` and all register fine. Without a
# resolvable context, init silently drops the service instead of registering
# it. Fixed by adding the same explicit seclabel here. (The earlier
# standalone-vs-merged-file theory and the drmrpc group removal were both
# real bugs in their own right, just not the actual cause of this specific
# symptom - keeping the merge since it's already proven to parse.)
service vendor.keymint-mitee /vendor/bin/hw/android.hardware.security.keymint@4.0-service.mitee
    class early_hal
    user root
    group system
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper_mitee /vendor/bin/hw/android.hardware.gatekeeper-service.mitee
    class hal
    user root
    group system
    seclabel u:r:recovery:s0

# /mnt/vendor/persist is declared in recovery.fstab but that only registers
# it with TWRP's own GUI mount manager - it's not mounted automatically at
# boot the way real firmware's vold/fstab.<hw> would. mitee's TA relies on
# real storage under here (confirmed live: without it, keymint-mitee
# SIGABRTs with "MiteeKeymint_ipc: Check failed: status == STATUS_OK" /
# TEEC oresult=TEEC_ORIGIN_TRUSTED_APP on its first TEE call that touches
# persistent storage).
#
# This runs as a `sleep`-then-mount oneshot service, not a plain `mount`
# line in an action, because every trigger tried (`fs`, `post-fs`,
# `property:hwservicemanager.ready=true`) fires too early on this device:
# logcat consistently showed the kernel actually mounting persist
# ("EXT4-fs (sdc16): mounted...") followed within ~200ms by "...
# unmounting..." attributed to TWRP's own "recovery" process, not init.
#
# The mechanism was previously put down to recovery.fstab's `check` flag.
# That is wrong: `check` reaches TWPartition::Check_FS_Type, which
# identifies the filesystem with a blkid probe and never mounts anything
# (partition.cpp:2217). What actually mounts persist is
# TWPartition::Update_Size, which mounts every partition with
# Can_Be_Mounted set purely to measure it (partition.cpp:3084-3087) and is
# run across the whole table by Update_System_Details - the
# "Updating partition details..." pass. Dropping `check` from the persist
# line would therefore not have helped. Note also that TWRP's one
# hardcoded persist special case, the /persist/time/ clock fixup at
# partition.cpp:660, does not apply here: it keys on the mount point being
# exactly /persist, and both this fstab and the stock vendor one mount the
# partition at /mnt/vendor/persist. That scan happened consistently ~2-4s into boot on the
# builds this was originally tuned against, earlier than every init
# trigger tried, so a flat sleep-8-then-mount-once was enough to land
# safely after it.
#
# On the stock-platform-fragment vendor_boot test (normal-boot fix, see
# README's KNOWN ISSUE section) this got a lot more scrutiny: a retry-loop
# version of this script (sleep 8, mount, then re-check/remount every 3s
# for a minute) never actually ran at all - init.svc.mount_persist_delayed
# came back "stopped" with zero trace of it in logcat, most likely a
# toybox sh syntax problem in the loop, not investigated further because
# a live test made the whole timing angle moot anyway: manually running
# this exact mount+restorecon+mkdir+chown+chmod+setprop sequence over adb
# while keymint-mitee was already mid-crash-loop made no difference
# whatsoever - it kept crash-looping at the same ~5s cadence for 5+
# minutes afterward. So persist mount timing was never the problem on
# this build; see the `user root` change above on tee-supplicant/
# keymint-mitee/gatekeeper_mitee for the actual current theory. Kept as a
# plain sleep-then-mount-once (reverted the untested loop) since there's
# no evidence anymore that landing after TWRP's scan-unmount is the hard
# part.
#
# The trailing bind of /mnt/vendor/persist onto /persist is unrelated to
# the TEE and exists purely to silence a recurring
# "Failed to mount '/persist' (Device or resource busy)" that followed
# every "Updating partition details..." in the UI. TWRP ends up knowing
# this one partition under two mount points: /mnt/vendor/persist from
# recovery.fstab, and /persist from MIUI's own vendor fstab, which
# TWPartitionManager::Setup_Fstab pulls off the real /vendor partition
# once it is mounted and re-parses as /etc/additional.fstab (see
# TWFunc::Find_Fstab in bootable/recovery). Update_System_Details() then
# tries to mount both, and whichever loses gets EBUSY. TW_SKIP_ADDITIONAL_FSTAB
# would drop the second entry outright, but that same additional fstab is
# handed to fscrypt_mount_metadata_encrypted() as its fstab argument, so
# disabling it risks the metadata decryption this device depends on -
# hence binding rather than skipping: TWPartition::Mount() returns early
# when Is_Mounted() finds the mount point in /proc/mounts, so /persist
# simply stops being something it needs to mount. It is appended after
# setprop so a failure here can never affect the TEE setup above it.
service mount_persist_delayed /system/bin/sh -c "sleep 8; mount -t ext4 -o noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc /dev/block/by-name/persist /mnt/vendor/persist; restorecon -R /mnt/vendor/persist; mkdir -p /mnt/vendor/persist/data; chown system:system /mnt/vendor/persist/data; chmod 0755 /mnt/vendor/persist/data; mkdir -p /mnt/vendor/persist/fdsd; chown system:system /mnt/vendor/persist/fdsd; chmod 0755 /mnt/vendor/persist/fdsd; setprop vendor.teefs_state ready; mkdir -p /persist; mount -o bind /mnt/vendor/persist /persist"
    class main
    user root
    group root
    seclabel u:r:recovery:s0
    disabled
    oneshot


on post-fs
    write /proc/bootprof "init tee-supplicant"
    chmod 0660 /dev/tee0
    chmod 0660 /dev/teepriv0
    chown system system /dev/tee0
    chown system system /dev/teepriv0
    chmod 0660 /dev/rpmb0
    chmod 0660 /dev/mmcblk0rpmb
    chmod 0660 /dev/0:0:0:49476
    chmod 0660 /dev/ufs-bsg0
    chmod 0666 /dev/kmsg
    chown system system /dev/rpmb0
    chown system system /dev/mmcblk0rpmb
    chown system system /dev/0:0:0:49476
    chown system system /dev/ufs-bsg0
#    enable vendor.keymaster-4-0-mitee
    enable vendor.keymint-mitee
    start tee-supplicant

# vendor.keymint-mitee/vendor.gatekeeper_mitee start on
# `property:hwservicemanager.ready` (same trigger already used by
# gatekeeper-1-0/keymaster a few lines below in init.recovery.mt6789.rc)
# rather than alongside tee-supplicant above. This is just when they're
# first kicked off, not when persist becomes available - see
# mount_persist_delayed above for that part; keymint-mitee crash-loops
# until persist is actually mounted regardless of this trigger's timing.
on property:hwservicemanager.ready=true
    start mount_persist_delayed
    setprop ro.hardware.gatekeeper mitee
    # Stock firmware relies on the generic AOSP init.rc's
    # `on late-init { class_start early_hal }` / `class_start hal` to
    # actually launch anything merely `enable`d (which only clears the
    # `disabled` flag - it does NOT start the service by itself) or
    # declared without `disabled` under class `early_hal`/`hal`. TWRP's
    # recovery init.rc doesn't replicate that generic class_start
    # sequence (everything else in this tree is started via explicit
    # `start <name>` tied to specific triggers instead - see
    # gatekeeper-1-0 in init.recovery.mt6789.rc for the existing
    # precedent), so without an explicit start here neither service ever
    # actually launches even though `enable`/registration succeeds -
    # confirmed live: keystore2 got as far as parsing VINTF and
    # negotiating the shared secret, then panicked with "Binder
    # transaction error NAME_NOT_FOUND" trying to connect to KeyMint.
    start vendor.keymint-mitee
    start vendor.gatekeeper_mitee
