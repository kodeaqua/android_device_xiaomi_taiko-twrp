on init
    # Create a more standard /dev/block layout for our scripts
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice
    mkdir /mnt/vendor/persist 0700 root root
    mount ext4 /dev/block/platform/bootdevice/by-name/persist /mnt/vendor/persist
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1
    setprop crypto.ready 1
    # keystore2.rc (vendor/twrp, TW_INCLUDE_CRYPTO := true) invokes
    # `/system/bin/keystore2 /tmp/misc/keystore` on `on late-init` - stock
    # Android uses /data/misc/keystore (created by AOSP's own generic
    # init.rc under on post-fs-data), but TWRP redirects it to /tmp since
    # /data isn't available this early in recovery. Nothing else creates
    # that directory, and keystore2 does NOT handle it missing gracefully -
    # it segfaults immediately (`Fatal signal 11, fault addr 0x0`) on every
    # single start attempt, confirmed live via `adb logcat`. `on init` runs
    # before `on late-init`, so this guarantees the directory exists first.
    mkdir /tmp/misc 0755 root root
    mkdir /tmp/misc/keystore 0700 root root

on fs
    install_keyring


on post-fs
    # Bring the touchscreen up as early as possible.
    #
    # taiko ships with three interchangeable panel/digitiser combinations and
    # the retail vendor_dlkm carries a driver for each. modules.load on the
    # real /vendor_dlkm loads all of them unconditionally, in this order, on
    # every single unit (lines 105-109):
    #
    #   nt36xxx_spi.ko  -> Novatek NT36523N (BOE)    fw novatek_ts_fw_boe.bin
    #                      Novatek NT36536  (Tianma) fw novatek_ts_fw_tm.bin
    #   focaltech_tp.ko -> FocalTech FT8205P (Huaxing)
    #                                        fw focaltech_ts_fw_huaxing.bin
    #
    # Each driver reads the active panel and bails out ("TP_COMPATIBLE IS NOT
    # CORRECT!" / "Not found compatible node") when it is not the one bound to
    # this unit, so loading both is exactly what stock does and is safe on any
    # variant. Earlier builds of this tree carried only nt36xxx_spi.ko and only
    # the BOE firmware, which is why touch was dead - not merely slow - on both
    # Tianma and Huaxing units.
    #
    # The Novatek driver does not talk to the panel the moment it probes: it
    # queues its firmware upload on a ~14s delayed work and the digitiser
    # reports nothing at all until that lands. Measured on real hardware,
    # nvt_ts_probe finished at 09:41:06.390 and firmware_request for
    # novatek_ts_fw_boe.bin fired at 09:41:20.379 - 13.99s later, with the
    # CPU idle throughout. That countdown starts when the module loads, so
    # whatever delays the load delays touch by the same amount.
    #
    # Left to TW_LOAD_VENDOR_MODULES, the load happens at ~9.3s into boot,
    # because these modules live on /vendor_dlkm - a logical partition TWRP
    # can only reach after it has mapped and mounted the super partition. All
    # four are committed to recovery/root/lib/modules instead (1.3MB together;
    # the rest of what they depend on - panel-o84-3{5,6}-* and panel-o84-42-*,
    # hqsysfs, mediatek_drm_v1, mtk_disp_notify, mtk_panel_ext,
    # xiaomi_usb_touch_notifier, and miev for xiaomi.ko - is already among the
    # factory fragment's 210 modules, at modules.load.recovery lines 8-197,
    # loaded by init well before this point) so they can be insmod'd here at
    # ~6.5s, moving first touch response from ~23.3s to ~20.5s.
    #
    # Order matters here in a way it does not for stock: modules.load is fed
    # to modprobe, which resolves `depends=` itself, while insmod does not.
    # xiaomi.ko is listed by both digitiser drivers and
    # xiaomi_headset_touch_notifier.ko by focaltech_tp.ko, so both go first.
    #
    # TW_LOAD_VENDOR_MODULES stays enabled as a fallback - it will simply
    # find them already loaded. The deferred firmware request still resolves
    # against the copies bundled at /vendor/firmware in this ramdisk, since
    # TWRP unmounts the real /vendor right after its own module pass, long
    # before the ~20.5s mark.
    insmod /lib/modules/xiaomi.ko
    insmod /lib/modules/xiaomi_headset_touch_notifier.ko
    insmod /lib/modules/nt36xxx_spi.ko
    insmod /lib/modules/focaltech_tp.ko

   start boot-hal-1-2
    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
    start mtk.plpath.utils.link
      # Support A/B feature for EMMC and UFS boot region
    #
    # A `wait /dev/block/mmcblk0boot0 2` used to sit here, inherited from
    # MTK's eMMC-oriented template. taiko is UFS-only - its boot regions
    # come up as the sda/sdb LUNs and no mmcblk0boot0 node is ever created
    # by the kernel (dmesg lists sda, sdb and sdc, nothing else) - so that
    # wait could only ever run out its full 2-second timeout, and it did so
    # on every single boot: ro.boottime shows mtk.plpath.utils.link at
    # 6.55s and then nothing until tee-supplicant/recovery at 8.57s, a
    # two-second stall in init that TWRP's own startup sits behind. It was
    # also self-defeating, since the very next line is what creates
    # mmcblk0boot0 in the first place (as a symlink onto sda) - it was
    # waiting for a node that only appears after it. Dropped; the symlinks
    # below need no wait, as symlink() does not require its target to exist.
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

    # Support A/B feature for combo emmc and ufs OTA update
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/platform/bootdevice/by-name/preloader_emmc_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/platform/bootdevice/by-name/preloader_emmc_b
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/platform/bootdevice/by-name/preloader_ufs_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/platform/bootdevice/by-name/preloader_ufs_b

on boot
    chown system system /dev/xiaomi-touch
    chmod 0664 /dev/xiaomi-touch
    chown system system /sys/class/touch/tp_dev/fod_status
    chmod 0664 /sys/class/touch/tp_dev/fod_status

service touchfeature-hal-1-0 /vendor/bin/hw/vendor.xiaomi.hardware.touchfeature@1.0-service
    class main
    user root
    group root
    onrestart restart touchfeature-hal-1-0
    seclabel u:r:recovery:s0


service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
    class main
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0

# NOTE: taiko does not use the Trustonic/"beanpod" TEE stack that rock
# (POCO M5) ships (taiko's kernel loads mitee.ko, Xiaomi's own in-house TEE,
# instead of the microtrust/teei stack). The teei_daemon service and the
# beanpod-branded hardware-backed keymint/gatekeeper HAL were therefore
# dropped rather than carried over unverified. taiko's real mitee-based
# KeyMint/Gatekeeper HAL is now bundled instead (see
# vendor/etc/init/{tee-supplicant,android.hardware.security.keymint.mitee@4.0-service,
# android.hardware.gatekeeper-service.mitee}.rc). A legacy generic AOSP
# software gatekeeper (gatekeeper-1-0) was initially kept alongside it as a
# supposedly harmless HIDL-namespace fallback; that assumption did not hold
# up on real hardware and it has since been removed.
#
# The gatekeeper-1-0 service definition, its two `start` triggers and the
# three `stop` blocks that used to follow this comment are gone, together
# with the /vendor/bin/hw/android.hardware.gatekeeper@1.0-service binary
# they pointed at. Describing it as a harmless fallback turned out to be
# wrong on real hardware: it can never register, because HIDL requires a
# matching <hal> entry in a VINTF manifest and there is none for
# android.hardware.gatekeeper@1.0 anywhere in this tree, so every start
# ended in
#
#   HidlServiceManagement: Service android.hardware.gatekeeper@1.0::IGatekeeper/default
#   must be in VINTF manifest in order to register/get.
#   init: Sending signal 9 to service 'gatekeeper-1-0' ... process group
#
# and init re-spawned it on its 5-second crash cooldown for as long as
# TWRP stayed up - the shipped binary is not even executable (0644), so it
# could not have worked regardless. That respawn loop is the most likely
# cause of the few seconds of unresponsiveness right after TWRP's UI comes
# up. The real, working AIDL gatekeeper (vendor.gatekeeper_mitee, in
# vendor/etc/init/tee-supplicant.rc) covers this device's gatekeeper needs
# on its own.
#
# The `start keymaster` / `stop keymaster` / `stop keymaster-4-1` lines
# that were interleaved with them went too: no service by any of those
# names is defined anywhere in this ramdisk, so init only logged errors
# for them. Keystore talks to vendor.keymint-mitee instead.
#
# The three libraries that service dlopen'd went with it in a later pass -
# vendor/lib64/hw/{android.hardware.gatekeeper@1.0-impl,gatekeeper.default,
# libSoftGatekeeper}.so - along with vendor/lib64/libdrm.so, which nothing
# in this ramdisk has ever referenced (AOSP's own libdrm is
# `recovery_available: true`, so TWRP ships one at /system/lib64, and that
# path comes first in LD_LIBRARY_PATH above; the vendor copy could only
# ever shadow-conflict). Verified by walking DT_NEEDED transitively from
# the only three things init starts here - the keymint and gatekeeper
# mitee services and tee-supplicant - and finding those four unreachable.
#
# Everything the reachable set needs from outside this ramdisk
# (libcppbor, libcppcose_rkp, libkeymaster_messages,
# libpuresoftkeymasterdevice, libhidlbase, libhardware, libcrypto, ...)
# is already relinked into /system/lib64 by TWRP itself - see
# bootable/recovery/prebuilt/Android.mk lines 194-217. That block is gated
# on TW_INCLUDE_CRYPTO_FBE, which we never set by hand: it is derived from
# our TW_INCLUDE_CRYPTO := true at bootable/recovery/Android.mk:339, and
# prebuilt/Android.mk is included after that (Android.mk:737), so the gate
# is open for taiko. The dependency closure is complete; a failure to
# decrypt is not a missing library.
on boot
    # health-hal-2-1 is real: TWRP installs its .rc into the recovery
    # fragment at /system/etc/init/android.hardware.health@2.1-service.rc
    # (bootable/recovery/etc/Android.mk:150), unconditionally.
    #
    # `start vendor.vibrator-default` used to follow and was removed. No
    # service by that name exists anywhere in what actually boots: TWRP
    # installs no vibrator .rc (see the list in bootable/recovery/etc/init),
    # the factory PLATFORM fragment carries none either, and AOSP's
    # android.hardware.vibrator-service.example - the only thing that
    # defines it, in hardware/interfaces/vibrator/aidl/default - is
    # `vendor: true` with no recovery_available, so neither its binary nor
    # its .rc is ever in this image. init silently ignored the line.
    #
    # Same reason TW_SUPPORT_INPUT_AIDL_HAPTICS is deliberately not set in
    # BoardConfig.mk: minuitwrp's vibrate() resolves the vibrator through
    # AServiceManager_getService(), which blocks while it waits for a
    # service that will never register.
    start health-hal-2-1
    setprop sys.usb.config adb
